msgstr "تحقق من أن cron في WordPress يعمل، أو دوّر المفتاح من إعدادات BackupPlus."

#: includes/class-credential-key-rotation.php:198
msgid "Credential key age alert"
msgstr "تنبيه عمر مفتاح بيانات الاعتماد"

