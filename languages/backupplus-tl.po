msgstr "Ang buong network (lahat ng site nito)"

#. translators: 1: Blog ID, 2: Site address
#: includes/class-multisite-restore.php:625
#, php-format
msgid "Only site %1$d: %2$s"
msgstr "Site %1$d lamang: %2$s"

#: includes/class-multisite-restore.php:627
