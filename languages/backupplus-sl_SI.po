msgstr "Izbrana datoteka je šifrirana. Vnesite geslo varnostne kopije ali zasebno identiteto, ki ustreza načinu šifriranja."

#: templates/wp-admin/settings/tab-extract.php:21
msgid "Backup passphrase (UpdraftPlus legacy passphrase-encrypted archives or age -p archives)"
msgstr "Geslo varnostne kopije (podedovani arhivi UpdraftPlus, šifrirani z geslom, ali arhivi age -p)"

