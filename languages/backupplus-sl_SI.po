#: templates/wp-admin/settings/delete-and-restore-modals.php:105
msgid "Used only for this recovery. Restore credentials are never saved in settings, jobs, logs or credential files. They are not needed for ordinary full-dump restores."
msgstr "Uporabljeno samo za to obnovitev. Poverilnice za obnovitev se nikoli ne shranijo v nastavitve, opravila, dnevnike ali datoteke s poverilnicami. Za običajne obnovitve polnih izpisov niso potrebne."

#: templates/wp-admin/settings/delete-and-restore-modals.php:106
msgid "Applies the full snapshot and every required binary-log stage directly to this site’s database. A pre-restore backup is retained. Individual tables cannot be selected for this restore."
msgstr "Uporabi polni posnetek in vse potrebne stopnje binarnega dnevnika neposredno v podatkovni bazi tega mesta. Varnostna kopija pred obnovitvijo je ohranjena. Posameznih tabel za to obnovitev ni mogoče izbrati."

#: templates/wp-admin/settings/delete-and-restore-modals.php:107
msgid "BackupPlus will temporarily take the site offline and block application database writes during recovery. Compatibility and permissions are checked before restoring."
msgstr "BackupPlus bo med obnovitvijo začasno onemogočil dostop do mesta in blokiral zapisovanje v podatkovno bazo aplikacije. Združljivost in dovoljenja se preverijo pred obnovitvijo."

#: templates/wp-admin/settings/delete-and-restore-modals.php:111
