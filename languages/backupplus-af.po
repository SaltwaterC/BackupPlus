msgstr "Die presiese tydinstelling vir databasis-punt-in-tyd-herstel is ongeldig."

#: includes/class-pitr-admin.php:103
msgid "Choose a valid exact time for database point-in-time recovery."
msgstr "Kies ’n geldige presiese tyd vir databasis-punt-in-tyd-herstel."

#: includes/class-pitr-admin.php:122
msgid "Could not prepare the WordPress database connection for point-in-time recovery."
msgstr "Kon nie die WordPress-databasisverbinding vir punt-in-tyd-herstel voorberei nie."

#: includes/class-pitr-admin.php:147
msgid "WordPress could not identify its active database connection."
msgstr "WordPress kon nie sy aktiewe databasisverbinding identifiseer nie."

#: includes/class-pitr-admin.php:150
msgid "Database point-in-time recovery requires PHP process support on a Unix host."
msgstr "Databasis-punt-in-tyd-herstel vereis PHP-prosesondersteuning op ’n Unix-gasheer."

#: includes/class-pitr-admin.php:160
msgid "WordPress database connection details are incomplete or unsupported."
msgstr "WordPress-databasisverbindingsbesonderhede is onvolledig of word nie ondersteun nie."

