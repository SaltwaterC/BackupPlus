#: includes/admin/trait-assets.php:231
msgid "Encrypted archives cannot be browsed here; decrypt them in the Extract tab."
msgstr "Els arxius xifrats no es poden explorar aquí; desxifreu-los a la pestanya Extreu."

#: includes/admin/trait-assets.php:232
msgid "Filter by date or time, for example 2026-10-26 15:5"
msgstr "Filtreu per data o hora, per exemple 2026-10-26 15:5"

#: includes/admin/trait-assets.php:233
msgid "Select all matching"
msgstr "Selecciona tots els coincidents"

#: includes/admin/trait-assets.php:234
msgid "Clear selection"
msgstr "Esborra la selecció"

#: includes/admin/trait-assets.php:235
msgid "Show more"
msgstr "Mostra'n més"

#: includes/admin/trait-assets.php:236
msgid "recovery point"
msgstr "punt de recuperació"

#: includes/admin/trait-assets.php:237
msgid "recovery points"
msgstr "punts de recuperació"

#: includes/admin/trait-assets.php:238
msgid "file(s)"
msgstr "fitxer(s)"

#: includes/admin/trait-assets.php:240
msgid "Download with earlier points"
msgstr "Baixa amb els punts anteriors"

#: includes/admin/trait-assets.php:241
msgid "Download this point with the full backup and every incremental point before it, which is everything needed to recover to it from files"
msgstr "Baixa aquest punt amb la còpia de seguretat completa i tots els punts incrementals anteriors, que és tot el necessari per recuperar-lo a partir de fitxers"

#: includes/admin/trait-assets.php:242 includes/admin/trait-assets.php:273
msgid "Download selected"
msgstr "Baixa la selecció"

#: includes/admin/trait-assets.php:244
msgid "Download all matching"
msgstr "Baixa tots els coincidents"

#: includes/admin/trait-assets.php:245
msgid "Delete selected from server"
msgstr "Suprimeix la selecció del servidor"

#: includes/admin/trait-assets.php:246
msgid "Delete from server"
msgstr "Suprimeix del servidor"

#: includes/admin/trait-assets.php:247
msgid "Delete this recovery point from this web server. Copies in remote storage are kept"
msgstr "Suprimeix aquest punt de recuperació d'aquest servidor web. Es conserven les còpies a l'emmagatzematge remot"

#: includes/admin/trait-assets.php:248
msgid "Delete this recovery point and every later one permanently, as a recovery point cannot be restored without the ones before it"
msgstr "Suprimeix aquest punt de recuperació i tots els posteriors de manera permanent, ja que un punt de recuperació no es pot restaurar sense els anteriors"

#: includes/admin/trait-assets.php:249
msgid "Delete selected from remote storage"
msgstr "Suprimeix la selecció de l'emmagatzematge remot"

#: includes/admin/trait-assets.php:250
msgid "Delete from remote storage"
msgstr "Suprimeix de l'emmagatzematge remot"

#: includes/admin/trait-assets.php:251
msgid "Delete this recovery point and every later one from remote storage. Copies on this web server are kept"
msgstr "Suprimeix aquest punt de recuperació i tots els posteriors de l'emmagatzematge remot. Es conserven les còpies d'aquest servidor web"

#: includes/admin/trait-assets.php:252
#: templates/wp-admin/settings/existing-backups-table.php:227
msgid "Deleting..."
msgstr ""

#: includes/admin/trait-assets.php:253
msgid "Nothing to delete: none of the selected recovery points has a copy there."
msgstr "No hi ha res a suprimir: cap dels punts de recuperació seleccionats hi té una còpia."

#. translators: 1: Number of files, 2: Size freed.
#: includes/admin/trait-assets.php:255
#, php-format
msgid "Deleted %1$d file(s) (%2$s) from this server."
msgstr "S'han suprimit %1$d fitxer(s) (%2$s) d'aquest servidor."

#. translators: %d: Number of files.
#: includes/admin/trait-assets.php:257
#, php-format
msgid "Deleted %d file(s) from remote storage."
msgstr "S'han suprimit %d fitxer(s) de l'emmagatzematge remot."

#. translators: 1: Number of recovery points, 2: Backup component, e.g. Uploads.
#: includes/admin/trait-assets.php:259
#, php-format
msgid "Delete the copies of %1$d recovery point(s) of %2$s from this web server? Copies in remote storage are kept and fetched again when needed."
msgstr "Voleu suprimir les còpies de %1$d punt(s) de recuperació de %2$s d'aquest servidor web? Les còpies de l'emmagatzematge remot es conserven i es tornen a obtenir quan calgui."

#. translators: 1: Number of recovery points, 2: Backup component, e.g. Uploads.
#: includes/admin/trait-assets.php:261
#, php-format
msgid "Permanently delete %1$d recovery point(s) of %2$s? A recovery point can only be restored together with everything before it, so the selected points and every later one are removed."
msgstr "Voleu suprimir de manera permanent %1$d punt(s) de recuperació de %2$s? Un punt de recuperació només es pot restaurar juntament amb tot el que hi ha abans, de manera que se suprimeixen els punts seleccionats i tots els posteriors."

#: includes/admin/trait-assets.php:262
msgid "Their copies in remote storage are deleted too."
msgstr "Les seves còpies a l'emmagatzematge remot també se suprimeixen."

#. translators: 1: Number of recovery points, 2: Backup component, e.g. Uploads.
#: includes/admin/trait-assets.php:264
#, php-format
msgid "Delete %1$d recovery point(s) of %2$s from remote storage? Every later recovery point is deleted there too, because it cannot be restored without the ones before it. Copies on this web server are kept."
msgstr "Voleu suprimir %1$d punt(s) de recuperació de %2$s de l'emmagatzematge remot? Tots els punts de recuperació posteriors també s'hi suprimeixen, perquè no es poden restaurar sense els anteriors. Es conserven les còpies d'aquest servidor web."

#. translators: %d: Number of recovery points.
#: includes/admin/trait-assets.php:266
#, php-format
msgid "%d of them are not on this web server and are lost permanently."
msgstr "%d d'ells no són en aquest servidor web i es perden de manera permanent."

#: includes/admin/trait-assets.php:267
msgid "No recovery points match."
msgstr "Cap punt de recuperació coincideix."

#: includes/admin/trait-assets.php:268
msgid "The request failed. Check your web server logs and try again."
msgstr "La sol·licitud ha fallat. Comproveu els registres del vostre servidor web i torneu-ho a provar."

#. translators: %d: Number of recovery points.
#: includes/admin/trait-assets.php:270
