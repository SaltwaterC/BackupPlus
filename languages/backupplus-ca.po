msgstr "Les adreces dels llocs només poden contenir lletres minúscules (a-z), números i guions."

#. translators: %s: Site address
#: includes/class-multisite-restore.php:228
#, php-format
msgid "The address %s is reserved for use by WordPress functions."
msgstr "L'adreça %s està reservada per a les funcions de WordPress."

#. translators: %s: Site address
#: includes/class-multisite-restore.php:234
#, php-format
