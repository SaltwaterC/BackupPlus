msgstr "Desmarqueu aquests components i inicieu la restauració de nou: %s"

#: includes/class-multisite-restore.php:126
msgid "This is a backup of a single site, not of a network."
msgstr "Aquesta és una còpia de seguretat d'un sol lloc, no d'una xarxa."

#. translators: %d: Site (blog) ID
#: includes/class-multisite-restore.php:130
#, php-format
