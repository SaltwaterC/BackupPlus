#. translators: %s: Site address
#: includes/class-multisite-restore.php:228
#, php-format
msgid "The address %s is reserved for use by WordPress functions."
msgstr "Адресът %s е резервиран за използване от функциите на WordPress."

#. translators: %s: Site address
#: includes/class-multisite-restore.php:234
#, php-format
msgid "The site %s already exists."
msgstr "Сайтът %s вече съществува."

#. translators: 1: Blog ID, 2: Site address
#: includes/class-multisite-restore.php:242
#, php-format
msgid "Created site %1$d (%2$s) to import the backup into"
msgstr "Създаден е сайт %1$d (%2$s), в който да се импортира резервното копие"

#: includes/class-multisite-restore.php:392
msgid "Could not move the new files into place. Check your wp-content/upgrade folder."
msgstr "Новите файлове не можаха да бъдат преместени на място. Проверете папката wp-content/upgrade."

#: includes/class-multisite-restore.php:462
msgid "Failed to create directory"
