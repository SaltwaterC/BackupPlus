#. translators: %d: Blog ID
#: includes/class-multisite-restore.php:516
#, php-format
msgid "The backup was imported into site %d."
msgstr "Резервното копие беше импортирано в сайт %d."

#. translators: 1: User login, 2: Database error
#: includes/class-multisite-restore.php:552
#, php-format
msgid "The user %1$s could not be added: %2$s"
msgstr "Потребителят %1$s не можа да бъде добавен: %2$s"

#. translators: 1: Number of users, 2: Number of new users
