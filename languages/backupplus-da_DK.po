#: includes/admin/trait-assets.php:119
msgid "Public recipient added. Click Save Changes to save it and enable age encryption."
msgstr "Offentlig modtager tilføjet. Klik på Gem ændringer for at gemme den og aktivere age-kryptering."

#: includes/admin/trait-assets.php:120
msgid "Could not generate an age key. Try again in a modern browser over HTTPS or localhost."
msgstr "Der kunne ikke genereres en age-nøgle. Prøv igen i en moderne browser via HTTPS eller localhost."

#: includes/admin/trait-assets.php:121
msgid "Local age key generation requires HTTPS (or localhost) and a modern browser with Web Crypto."
msgstr "Lokal generering af age-nøgler kræver HTTPS (eller localhost) og en moderne browser med Web Crypto."

#: includes/admin/trait-assets.php:122
msgid "You can save at most 100 recipient entries. Remove an entry before generating another key."
msgstr "Du kan højst gemme 100 modtagerposter. Fjern en post, før du genererer en ny nøgle."

#: includes/admin/trait-assets.php:138
msgid "Decrypting locally:"
msgstr "Dekrypterer lokalt:"

#: includes/admin/trait-assets.php:139
msgid "Extracting locally:"
msgstr "Udpakker lokalt:"

#: includes/admin/trait-assets.php:141
msgid "Decrypting:"
msgstr "Dekrypterer:"

#: includes/admin/trait-assets.php:142
msgid "Extracting:"
msgstr "Udpakker:"

#: includes/admin/trait-assets.php:144
msgid "Downloading encrypted archive:"
msgstr "Downloader krypteret arkiv:"

#: includes/admin/trait-assets.php:145
msgid "Uploading plaintext restore copy:"
msgstr "Uploader ukrypteret gendannelseskopi:"

#: includes/admin/trait-assets.php:146 includes/admin/trait-assets.php:239
msgid "Download"
msgstr "Download"

#: includes/admin/trait-assets.php:147
msgid "Extraction complete. Download your files, then clear the files to remove temporary browser copies."
msgstr "Udpakningen er fuldført. Download dine filer, og ryd derefter filerne for at fjerne midlertidige browserkopier."

#: includes/admin/trait-assets.php:148
msgid "Extraction cancelled. Temporary output and keys have been cleared."
msgstr "Udpakningen blev annulleret. Midlertidigt output og nøgler er ryddet."

#: includes/admin/trait-assets.php:149
msgid "This is not an encrypted or compressed backup archive, so there is nothing to extract."
msgstr "Dette er ikke et krypteret eller komprimeret backuparkiv, så der er intet at udpakke."

#: includes/admin/trait-assets.php:150
msgid "Nothing to extract: none of the selected files is encrypted, compressed or a set of backup archives."
msgstr "Intet at udpakke: ingen af de valgte filer er krypterede, komprimerede eller et sæt backuparkiver."

#. translators: %d: number of links, devices and other special entries that were not extracted from a tar archive
#: includes/admin/trait-assets.php:152
#, php-format
msgid "%d symbolic links or special files in the archive were not extracted."
msgstr "%d symbolske links eller specialfiler i arkivet blev ikke udpakket."

#: includes/admin/trait-assets.php:153
msgid "Legacy encryption: integrity cannot be verified. Check the downloaded archive before use."
msgstr "Ældre kryptering: integriteten kan ikke verificeres. Kontrollér det downloadede arkiv, før det bruges."

#: includes/admin/trait-assets.php:155 includes/class-wpadmin-commands.php:108
msgid "Could not transfer the restore archives. Retry the restore preparation."
msgstr "Gendannelsesarkiverne kunne ikke overføres. Prøv forberedelsen af gendannelsen igen."

#: includes/admin/trait-assets.php:156
msgid "Temporary browser files could not be removed. Close other extraction tabs and clear files again, or clear this site’s browser storage."
msgstr "Midlertidige browserfiler kunne ikke fjernes. Luk andre udpakningsfaner, og ryd filerne igen, eller ryd dette websteds browserlager."

#: includes/admin/trait-assets.php:157
msgid "Browser storage is full or unavailable. Free local space and try again."
msgstr "Browserlageret er fuldt eller utilgængeligt. Frigør lokal plads, og prøv igen."

#: includes/admin/trait-assets.php:158
msgid "Unable to decrypt. Check the passphrase or identity and that the archive is complete and unmodified."
msgstr "Kunne ikke dekryptere. Kontrollér adgangssætningen eller identiteten, og at arkivet er komplet og uændret."

#: includes/admin/trait-assets.php:159
msgid "Unable to extract. The archive is incomplete, damaged or in an unsupported format. Zip files must be stored or deflated and not password protected."
msgstr "Kunne ikke udpakke. Arkivet er ufuldstændigt, beskadiget eller i et format, der ikke understøttes. Zip-filer skal være lagret eller deflatet og må ikke være adgangskodebeskyttede."

#: includes/admin/trait-assets.php:160
msgid "Unsupported private key format or cipher. Use a native age identity, an OpenSSH RSA/Ed25519 key (unencrypted or bcrypt with AES-256-CTR/AES-256-GCM), or a PEM key (unencrypted or PBES2/PBKDF2/AES-CBC)."
msgstr "Privatnøgleformatet eller chifferen understøttes ikke. Brug en indbygget age-identitet, en OpenSSH RSA/Ed25519-nøgle (ukrypteret eller bcrypt med AES-256-CTR/AES-256-GCM) eller en PEM-nøgle (ukrypteret eller PBES2/PBKDF2/AES-CBC)."

#: includes/admin/trait-assets.php:161
msgid "Local decryption and extraction require HTTPS (or localhost), Web Crypto and Web Workers in a modern browser."
msgstr "Lokal dekryptering og udpakning kræver HTTPS (eller localhost), Web Crypto og Web Workers i en moderne browser."

#: includes/admin/trait-assets.php:162
msgid "This browser cannot stage large files locally. Allow private browser storage or use a browser with Origin Private File System support. Files above 128 MiB require that storage."
msgstr "Denne browser kan ikke mellemlagre store filer lokalt. Tillad privat browserlager, eller brug en browser med understøttelse af Origin Private File System. Filer over 128 MiB kræver dette lager."

#: includes/admin/trait-assets.php:163
msgid "The local extraction worker could not run. Check browser storage, memory and site policy, then try again."
msgstr "Den lokale udpakningsworker kunne ikke køre. Kontrollér browserlager, hukommelse og webstedets politik, og prøv igen."

#: includes/admin/trait-assets.php:204
msgid "Send a report only when there are warnings/errors"
msgstr "Send kun en rapport når der er advarsler/fejl"

#: includes/admin/trait-assets.php:205
msgid "When email storage method is enabled, and an email address is entered, also send the backup"
msgstr ""

#. translators: %s: Typical mail server size limit in megabytes
#: includes/admin/trait-assets.php:207
#, php-format
msgid "Be aware that mail servers tend to have size limits; typically around %s Mb; backups larger than any limits will likely not arrive."
msgstr "Vær opmærksom på at mailservere ofte har en størrelsesbegrænsning; typisk omkring %s Mb; backup større end disse grænser vil sandsynligvis ikke blive modtaget."

#: includes/admin/trait-assets.php:208
msgid "Rescanning (looking for backups that you have uploaded manually into the internal backup store)..."
msgstr "Scanner igen (søger efter backup's, du manuelt har uploaded til det interne backup lager)..."

#: includes/admin/trait-assets.php:209
msgid "Only email the database backup"
msgstr "Mail kun database backup'en"

#: includes/admin/trait-assets.php:210
msgid "Rescanning remote and local storage for backup sets..."
msgstr "Scanner igen både fjern- og lokal-lager for backup-sæt..."

#: includes/admin/trait-assets.php:211
msgid "To send to more than one address, separate each address with a comma."
msgstr "Adskil hver adresse med et komma, for at sende til flere adresser."

#: includes/admin/trait-assets.php:212
msgid "If you exclude both the database and the files, then you have excluded everything!"
msgstr "Hvis du fravælger både databasen og filerne, har du fravalgt alt!"

#: includes/admin/trait-assets.php:213
msgid "You have chosen to backup files, but no file entities have been selected"
msgstr "Du har valgt at tage backup, men har ikke valgt nogle filer"

#: includes/admin/trait-assets.php:214
