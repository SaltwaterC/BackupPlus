msgstr "Søgning efter denne enhed er startet"

#: includes/admin/trait-assets.php:228 includes/admin/trait-assets.php:243
msgid "Download all"
msgstr "Download alle"

#: includes/admin/trait-assets.php:229
msgid "Recovery points"
msgstr "Gendannelsespunkter"

#: includes/admin/trait-assets.php:230
