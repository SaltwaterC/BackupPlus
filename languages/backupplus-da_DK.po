#: includes/class-manipulation-functions.php:693
msgid "[deleted]"
msgstr ""

#. translators: Deleted long text.
#: includes/class-manipulation-functions.php:697
msgid "This content was deleted in order to anonymize it."
msgstr ""

#: includes/class-multisite-restore.php:109
msgid "This is a backup of a single site. Choose the site of this network to import it into in the database restoration options."
msgstr "Dette er en backup af ét enkelt websted. Vælg det websted i dette netværk, som den skal importeres til, i indstillingerne for databasegendannelse."

#: includes/class-multisite-restore.php:118
msgid "Only the database and the uploads can be restored into a single site of a network: plugins, themes, WordPress core and other content are shared by all its sites."
msgstr "Kun databasen og uploads kan gendannes til ét enkelt websted i et netværk: plugins, temaer, WordPress-kernen og andet indhold deles af alle dets websteder."

#. translators: %s: Comma-separated list of components
#: includes/class-multisite-restore.php:120
#, php-format
msgid "Deselect these components and start the restore again: %s"
