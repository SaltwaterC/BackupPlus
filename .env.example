WP_PORT=8080
PHP_CLI_SERVER_WORKERS=4
WP_SITE_TITLE="BackupPlus Development"
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=backupplus_dev
WP_ADMIN_EMAIL=admin@example.test
DEV_LOGIN_TOKEN=backupplus-local-dev-login
HOST_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt

DB_NAME=backupplus
DB_USER=backupplus
DB_PASSWORD=backupplus_dev
DB_ROOT_PASSWORD=backupplus_root

# Local PITR test accounts; provisioned in MariaDB, never injected into WordPress.
# Enter the backup login in Settings and the restore login only in the restore screen.
DB_BACKUP_USER=backupplus_backup
DB_BACKUP_PASSWORD=backupplus_backup_dev
DB_RESTORE_USER=backupplus_restore
DB_RESTORE_PASSWORD=backupplus_restore_dev
