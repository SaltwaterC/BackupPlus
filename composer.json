{
    "name": "backupplus/dev-tools",
    "description": "Development tools for BackupPlus; runtime dependencies are bundled separately.",
    "type": "project",
    "license": "GPL-3.0-only",
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.2",
        "squizlabs/php_codesniffer": "^3.13.5",
        "wp-coding-standards/wpcs": "^3.4"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true,
        "vendor-dir": ".cache/php-tools/vendor"
    }
}
